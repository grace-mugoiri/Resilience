# Copy to .env.local (ignored by git) and change if the API runs elsewhere.
# Base URL of the Resilience API. Use the public https:// address in production.
VITE_API_BASE=http://localhost:8000
# Hex public key that signs the API's client configuration. Copy PLATFORM_PUBKEY from backend/.env.
# Chat refuses to start without it, because it is how the app knows which relays to trust.
VITE_PLATFORM_PUBKEY=
