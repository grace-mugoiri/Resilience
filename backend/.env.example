# Copy to .env and fill in. Never commit .env.
APP_ENV=dev
# Compose reads this file both for substitution and for service environment variables.
BACKEND_ENV_FILE=.env
POSTGRES_IMAGE=postgres:16.15
NOSTR_RELAY_IMAGE=scsibug/nostr-rs-relay:0.10.0
POSTGRES_USER=resilience
POSTGRES_PASSWORD=resilience
POSTGRES_DB=resilience
# Used by commands run directly on the host.
DATABASE_URL=postgresql+psycopg://resilience:resilience@localhost:5433/resilience
# Used inside Docker, where the database is available as db:5432.
DOCKER_DATABASE_URL=postgresql+psycopg://resilience:resilience@db:5432/resilience
# The public URL clients sign in NIP-98 requests. Behind a proxy this is NOT what FastAPI sees.
PUBLIC_API_BASE=http://localhost:8000
# Exact origins of the web client, comma separated. Never "*".
# 5173 is the Vite dev server of the web client (frontend branch).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Hex public key of the platform key that signs the client config (printed by scripts/sign_config.py).
PLATFORM_PUBKEY=
SIGNED_CONFIG_PATH=config/client-config.signed.json
# Public relay URLs signed into /v1/config. Use wss:// URLs outside local development.
CLIENT_RELAY_URLS=ws://localhost:7777,ws://localhost:7778
# Optional override. Empty uses 30000:<platform-pubkey>:approved-orgs.
APPROVED_ORGS_LIST=
# Host ports for the local Docker stack only.
API_PORT=8000
POSTGRES_PORT=5433
RELAY_1_PORT=7777
RELAY_2_PORT=7778
NIP98_WINDOW_SECONDS=60
SENSITIVE_CHALLENGE_SECONDS=120
# Generate with: openssl rand -hex 32. Changing it invalidates stored blinded memberships.
RELAY_POLICY_HMAC_KEY=dev-only-change-me
# Separate encryption key for recoverable member routing boxes.
MEMBERSHIP_BOX_KEY=dev-only-membership-box-key-change-me
# Separate from the relay key. Changing it invalidates unclaimed counselor invite codes.
COUNSELOR_INVITE_HMAC_KEY=dev-only-invite-key-change-me
RELAY_POLICY_PORT=50051
GUEST_EVENT_MAX_SECONDS=300
ACCOUNT_EVENT_MAX_SECONDS=2592000
DISBURSEMENT_APPROVAL_THRESHOLD=2
# Hex pubkeys allowed to approve and suspend organisations, comma separated (nak decode npub1...).
ADMIN_PUBKEYS=
# Dev only: fetch nostr.json from here instead of https://<org domain>. Leave empty in production.
NIP05_DEV_BASE_URL=
