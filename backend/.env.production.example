# Copy to a secrets-managed production environment. Do not commit the populated file.
APP_ENV=prod
BACKEND_ENV_FILE=.env.production
POSTGRES_IMAGE=postgres:16.15
NOSTR_RELAY_IMAGE=scsibug/nostr-rs-relay:0.10.0
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=resilience
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DATABASE_HOST:5432/resilience
DOCKER_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DATABASE_HOST:5432/resilience
PUBLIC_API_BASE=https://api.resilience.example
CORS_ORIGINS=https://app.resilience.example
PLATFORM_PUBKEY=64_HEX_CHARACTER_PUBLIC_KEY
SIGNED_CONFIG_PATH=config/client-config.signed.json
CLIENT_RELAY_URLS=wss://relay-1.resilience.example,wss://relay-2.resilience.example
APPROVED_ORGS_LIST=
NIP98_WINDOW_SECONDS=60
SENSITIVE_CHALLENGE_SECONDS=120
RELAY_POLICY_HMAC_KEY=GENERATE_WITH_OPENSSL_RAND_HEX_32
MEMBERSHIP_BOX_KEY=GENERATE_A_DIFFERENT_SECRET_WITH_OPENSSL_RAND_HEX_32
COUNSELOR_INVITE_HMAC_KEY=GENERATE_A_DIFFERENT_32_BYTE_SECRET
RELAY_POLICY_PORT=50051
GUEST_EVENT_MAX_SECONDS=300
ACCOUNT_EVENT_MAX_SECONDS=2592000
DISBURSEMENT_APPROVAL_THRESHOLD=2
ADMIN_PUBKEYS=COMMA_SEPARATED_64_HEX_PUBLIC_KEYS
NIP05_DEV_BASE_URL=
LIGHTNING_NETWORK=bc
NWC_STORAGE_KEY=GENERATE_A_DIFFERENT_SECRET_WITH_OPENSSL_RAND_HEX_32
NWC_TIMEOUT_SECONDS=12
DONATION_MIN_SAT=100
DONATION_MAX_SAT=10000000
# Host mappings are only used if this Compose file publishes the services directly.
API_PORT=8000
POSTGRES_PORT=5433
RELAY_1_PORT=7777
RELAY_2_PORT=7778
