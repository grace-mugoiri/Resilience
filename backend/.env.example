# Copy to .env and fill in. Never commit .env.
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://resilience:resilience@localhost:5432/resilience
# The public URL clients sign in NIP-98 requests. Behind a proxy this is NOT what FastAPI sees.
PUBLIC_API_BASE=http://localhost:8000
# Exact origins of the web client, comma separated. Never "*".
# 5173 is the Vite dev server of the web client (frontend branch).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Hex public key of the platform key that signs the client config (printed by scripts/sign_config.py).
PLATFORM_PUBKEY=
SIGNED_CONFIG_PATH=config/client-config.signed.json
NIP98_WINDOW_SECONDS=60
SENSITIVE_CHALLENGE_SECONDS=120
# Generate with: openssl rand -hex 32. Changing it invalidates stored blinded memberships.
RELAY_POLICY_HMAC_KEY=dev-only-change-me
# Separate from the relay key. Changing it invalidates unclaimed counselor invite codes.
COUNSELOR_INVITE_HMAC_KEY=dev-only-invite-key-change-me
RELAY_POLICY_PORT=50051
GUEST_EVENT_MAX_SECONDS=300
ACCOUNT_EVENT_MAX_SECONDS=2592000
DISBURSEMENT_APPROVAL_THRESHOLD=2
# Hex pubkeys allowed to approve and suspend organisations, comma separated (nak decode npub1...).
ADMIN_PUBKEYS=
# Dev only: fetch nostr.json from here instead of https://<org domain>. Leave empty in production.
NIP05_DEV_BASE_URL=
