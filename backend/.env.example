# Resilience backend — development environment variables
# Copy to .env and adjust as needed. Nothing here is a real secret.

# SQLite by default for local dev; swap for a postgresql:// URL to use Postgres.
DATABASE_URL=sqlite:///./resilience_dev.db

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Toggles for mock integrations (all TRUE for the hackathon prototype).
NOSTR_MOCK=true
WALLET_MOCK=true
